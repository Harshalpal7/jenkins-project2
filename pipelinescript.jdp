
pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Harshalpal7/jenkins-project2'

                echo 'Pull Success'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }

                echo 'Build Success'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'sonarqube',
                    credentialsId: 'sonar-cred'
                ) {
                    dir('backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.0.0.4389:sonar \
                            -Dsonar.projectKey=project-02 \
                            -Dsonar.projectName=project-02
                        '''
                    }
                }

                echo 'TEST Successful'
            }
        }

        stage('QUALITY-GATE') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true,
                        credentialsId: 'sonar-cred'
                    )
                }

                echo 'QUALITY GATE PASSED'
            }
        }

        stage('UPLOAD TO S3') {
            steps {
                sh '''
                    aws s3 cp backend/target/student-registration-backend-0.0.1-SNAPSHOT.jar s3://my-jenkins-bucket-01/project-02/student-registration-backend.jar
                '''

                echo 'S3 Upload Success'
            }
        }

        stage ('RELEASE-PROCCESS') {
           steps {
               timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Approval is required. Shall we proceed?, OK : "Approve"'

               }
           }
         }
    }
}
