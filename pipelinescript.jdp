pipeline { 
    agent any
        stages { 
            stage('PULL') {
                steps { 
                    git branch: 'main', url: 'https://github.com/Harshalpal7/jenkins-project2'
                    echo 'Pull Success'
                }
            }
            stage('BUILD') {
                steps {
                    dir('backend') { 
                       sh 'mvn clean package -DskipTests'
                    }
                    echo 'Build Sucess'
                }
            }
            stage('TEST') {
                steps { 
                    echo 'Test Success'
                }
            }
            stage('DEPLOY') {
                steps { 
                    echo 'Deploy Success'
                }
            }
        }
}
