pipeline { 
    agent any
        stages { 
            stage('PULL') {
                steps { 
                    git branch: 'main', url: 'https://github.com/Harshalpal7/jenkins-project2'
                    echo 'Pull Success'
                }
            }
            stage('BUILD') {
                steps {
                    dir('backend') { 
                       sh 'mvn clean package -DskipTests'
                    }
                    echo 'Build Sucess'
                }
            }
            stage('TEST') {
                steps {
                    dir('backend') {
                       sh '''mvn org.sonarsource.scanner.maven:sonar-maven-p
lugin:sonar \\
  -Dsonar.projectKey=project-02 \\
  -Dsonar.projectName=\'project-02\' \\
  -Dsonar.host.url=http://43.204.171.31:9000 \\
  -Dsonar.token=sqp_e3d8bb97b7f1a87851ae1336ac2695bbc4817e18'''
                    }
             
                }
            }
            stage('DEPLOY') {
                steps { 
                    echo 'Deploy Success'
                }
            }
        }
}
