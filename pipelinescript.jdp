pipeline { 
    agent any
        stages { 
            stage('PULL') {
                steps { 
                    git branch: 'main', url: 'https://github.com/Harshalpal7/jenkins-project2'
                    echo 'Pull Success'
                }
            }
            stage('BUILD') {
                steps {
                    dir('backend') { 
                       sh 'mvn clean package -DskipTests'
                    }
                    echo 'Build Sucess'
                }
            }
            stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'sonarqube',
                    credentialsId: 'sonar-cred'
                ) {
                    dir('backend') {
                        sh '''mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
  -Dsonar.projectKey=test-project \
  -Dsonar.projectName='test-project'
'''
                    }
                }

                echo 'TEST-SUCCESS'
            }
        }

            stage('DEPLOY') {
                steps { 
                    echo 'Deploy Success'
                }
            }
        }
}
