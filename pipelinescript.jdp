pipeline { 
    agent any
        stages { 
            stage('PULL') {
                steps { 
                    git branch: 'main', url: 'https://github.com/Harshalpal7/jenkins-project2'
                    echo 'Pull Success'
                }
            }
            stage('BUILD') {
                steps {
                    dir('backend') { 
                       sh 'mvn clean package -DskipTests'
                    }
                    echo 'Build Sucess'
                }
            }
            stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'sonarqube',
                    credentialsId: 'sonar-cred'
                ) {
                    dir('backend') {
                        sh '''mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
  -Dsonar.projectKey=project-02 \
  -Dsonar.projectName='project-02'
'''
                    }
                }

                echo 'TEST-SUCCESSfull'
            }
        }
        stage('QUALITY-GATE') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true, credentialsId: 'sonar-cred'
                echo 'QUALITY-PASSED'
                }

                echo 'QUALITY-PASSED'
            }
        }    
            stage('STORE-ARTIFACT') {
                steps {
                    sh 'aws s3 cp backend/target/student-registration-backend-0.0.1-SNAPSHOT.jar \\ s3://my-jenkins-bucket-01/student-app.jar ' 
                    echo 'artifactbackup-success'
                }
            }
        }
}
